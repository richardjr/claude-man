# Project definition  ->  ~/.config/claude-man/projects/<slug>.toml
# A project EXISTS iff this file exists. Durable, secret-free, git-versionable.
# Copy to ~/.config/claude-man/projects/my-project.toml and edit.

[project]
slug    = "my-project"
profile = "work"            # optional; omit to inherit the default profile
overlay = "node"            # image variant: base | python | rust | node
extra_apt = ["jq"]          # optional: thin per-project apt layer baked at create time
# claude_version = "2.1.169"  # optional: pin this project's claude to an exact version (overrides the
#                             # global channel/pin from `config image`). Omit to track the global setting.
# env_file = "~/projects/my-project.env"   # alternative to [project.env]
# workdir = "my-app-backend"     # where claude/shell launch (docker exec -w). Omit to launch at
#                                # /workspace (the uniform anchor — see docs/PACKS.md).
# ssh_auto_trust = true          # opt-in (default off): auto-trust UNKNOWN ssh host keys on first
#                                # connect (TOFU; StrictHostKeyChecking accept-new). The common forges
#                                # (github/gitlab/bitbucket/azure) are pre-trusted by the baked
#                                # known_hosts regardless — turn this on only for self-hosted/other
#                                # forges. Toggle: `project ssh-trust <slug> on|off` / TUI Env mounts (t).

# Curated packs (docs/PACKS.md): bundles of CLAUDE.md fragments + skills from the in-repo library,
# materialized into the asset source and synced into the binds on every start. `language` picks the
# tier whose `default = true` packs are applied at CREATE (resolved once, written here explicitly —
# no silent creep). Manage with `project packs add/rm/list/defaults` or TUI Project menu -> Packs…
# (changes apply immediately; no recreate).
language = "node"               # pack tier: common-only when omitted ("" = none)
packs    = ["guardrails", "code-quality", "node-conventions"]

# Model pin (docs/MODELS.md) — ONE choice per project, of two kinds (setting both is a load error):
# claude_model = "claude-fable-5"   # launch claude as `claude --model <ref>` (an id or alias like
#                                   # "opus"). Applies at the next launch — no recreate, no gateway,
#                                   # allowed when locked. Manage: `project model set <slug> --claude …`
# model = "qwen3-coder:30b"         # LOCAL (Ollama) pin -> HYBRID mode (gateway sidecar; recreate to
#                                   # apply; refused on a locked project). `project model set <slug> <tag>`

[project.egress]
mode      = "open"          # "open" (default) or "strict"
allowlist = ["registry.yarnpkg.com", "objects.githubusercontent.com"]  # strict mode only

[project.env]
# Injected as -e KEY=VAL at run time (never baked into an image layer).
# ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN are forbidden here (they would outrank the token).
NODE_ENV = "development"
ENV      = "local"

[[project.repos]]
url    = "git@github.com:your-org/my-app-backend.git"
branch = "main"
dir    = "my-app-backend"       # relative path under workspace/ -> /workspace/my-app-backend

[[project.repos]]
url    = "git@github.com:your-org/my-app-client.git"
branch = "main"
dir    = "my-app-client"

# Environment mounts -> host material made available INSIDE the container for the agent's own
# runtime / git-over-ssh. PATHS ONLY (never a secret value). Mounts are fixed at container create,
# so a change needs `project recreate`. Manage with `project env add/rm/list` + `project resync`.

# ssh: forward the host ssh-agent (private keys stay on the host) + seed ~/.ssh/{config,known_hosts}.
# The common git forges are pre-trusted by a baked global known_hosts, so git-over-ssh to
# github/gitlab/bitbucket/azure verifies with no prompt even if THIS host never SSH'd to them. For
# other/self-hosted forges, set `ssh_auto_trust = true` above (TOFU) or `ssh-keyscan` into known_hosts.
[[project.env_mount]]
kind = "ssh"

# file: bind a host file at an absolute container path (read-only by default).
[[project.env_mount]]
kind = "file"
src  = "~/.netrc"                 # host path (~ and $VARS expanded host-side)
dst  = "/home/agent/.netrc"       # absolute container path (a trailing "/" appends the src basename)
# ro = false                      # opt-in writable (default true)

# A workspace-root CLAUDE.md (above the per-repo ones) — /workspace/<path> is allowed; the nested
# mountpoint is pre-created operator-owned. (Bare /home/agent/.claude, /tmp, /home/agent/.cache,
# /home/agent/.ssh, /home/agent/.local are reserved.)
[[project.env_mount]]
kind = "file"
src  = "~/projects/CLAUDE.md"
dst  = "/workspace/CLAUDE.md"

# Published ports -> expose a service running INSIDE the container (a dev server / test endpoint) so
# the host (or, opt-in, the LAN) can reach it. Rendered as `-p <bind>:<host>:<container>/<proto>`.
# `container` must be >= 1024 (the hardened profile drops NET_BIND_SERVICE, so a service inside can't
# bind a privileged port). Fixed at container create -> `project recreate` to apply. Manage with
# `project ports add/rm/list`. NOTE: the in-container service must listen on 0.0.0.0 (not localhost).
[[project.ports]]
container = 5173                 # service inside the container
# host    = 5173                 # host port (optional; defaults to the container port)
# bind    = "127.0.0.1"          # default: host-only (reachable at http://localhost:5173). "0.0.0.0" = LAN
# proto   = "tcp"                # "tcp" (default) | "udp"
